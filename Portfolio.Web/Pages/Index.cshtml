@page
@model Portfolio.Web.Pages.IndexModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home";

    // Featured projects, in carousel order. Each is rendered twice by _ProjectCard:
    // once as the real card and once as an inert copy that makes the CSS loop seamless.
    var projects = new (string Id, string Icon, string Title, string Desc, string[] Stack,
                        string Demo, string Details, string DetailsLabel)[]
    {
        ("state-explorer", "fa-map", "US State Explorer",
            "Explore, compare, and analyze U.S. states with an interactive ArcGIS-powered dashboard and ASP.NET Core backend.",
            new[] { "ArcGIS JS", "ASP.NET Core", "GeoJSON" },
            "/Projects/StateExplorer/Index", "/Projects/StateExplorer/Details", "View technical details for US State Explorer"),
        ("home-finder", "fa-house", "Redlands Smart Home Finder",
            "GIS-powered tool to discover and rank the top 10 homes in Redlands, CA based on weighted preferences and a composite scoring algorithm.",
            new[] { "ArcGIS JS", "ASP.NET Core", "PostgreSQL" },
            "/Projects/HomeFinder/Index", "/Projects/HomeFinder/Details", "View technical details for Redlands Smart Home Finder"),
        ("plant-ops", "fa-industry", "Plant Operations Dashboard",
            "Industrial plant operations dashboard for a fiberglass ducting manufacturer. Shipment GIS routing, order management, inventory tracking with transaction audit logs, and a live revenue dashboard.",
            new[] { "ASP.NET Core", "DataTables", "Esri GIS", "PostgreSQL" },
            "/Projects/PlantOperationsDashboard/Index", "/Projects/PlantOperationsDashboard/Details", "View technical details for Plant Operations Dashboard"),
        ("batch-geocoding", "fa-map-location-dot", "Batch Geocoding",
            "Upload a CSV of addresses and geocode them in bulk via ArcGIS. View match rates, scores, and coordinates in an interactive DataTables results grid with export support.",
            new[] { "ArcGIS Geocoding", "ASP.NET Core", "C#" },
            "/Projects/BatchGeocoding/Index", "/Projects/BatchGeocoding/Details", "View technical details for Batch Geocoding"),
        ("reverse-geocoding", "fa-map-pin", "Reverse Geocoding",
            "Click anywhere on an interactive ArcGIS map to instantly discover the address or place at that location, with a history of recent lookups and manual coordinate entry.",
            new[] { "ArcGIS Geocoding", "ASP.NET Core", "C#" },
            "/Projects/ReverseGeocoding/Index", "/Projects/ReverseGeocoding/Details", "View technical details for Reverse Geocoding"),
        ("address-std", "fa-address-card", "Address Standardization & Validation",
            "Parse freeform addresses into structured components with NLP-style regex extraction, then validate and score them against ArcGIS geocoding with a confidence tier result.",
            new[] { "ArcGIS Geocoding", "NLP Parsing", "ASP.NET Core" },
            "/Projects/AddressStandardization/Index", "/Projects/AddressStandardization/Details", "View technical details for Address Standardization"),
        ("geostream", "fa-satellite-dish", "Live Location Stream",
            "Live-style telemetry processing that aggregates GPS events into spatial grid cells and flags high-speed anomalies through a native-backed stream kernel.",
            new[] { "Telemetry", "ASP.NET Core", "C++20", "P/Invoke" },
            "/Projects/GeoStream/Index", "/Projects/GeoStream/Details", "View technical details for Live Location Stream"),
        ("geometry", "fa-draw-polygon", "Geometry Toolkit",
            "Computational geometry demo for triangulation and polygon clipping with a clean ASP.NET Core API over a native C++ geometry kernel.",
            new[] { "Geometry", "GIS", "C++20", "Razor Pages" },
            "/Projects/Geometry/Index", "/Projects/Geometry/Details", "View technical details for Geometry Toolkit"),
        ("terrain", "fa-mountain-sun", "Terrain Analyzer",
            "Raster analysis interface for hillshade and heatmap generation over dense grids, backed by a native terrain kernel with a managed fallback.",
            new[] { "Raster", "Terrain", "C++20", "ASP.NET Core" },
            "/Projects/Terrain/Index", "/Projects/Terrain/Details", "View technical details for Terrain Analyzer"),
        ("network", "fa-route", "Route Planner",
            "Spatial graph analysis demo for shortest-path routing and service-area traversal over a native-backed network engine.",
            new[] { "Routing", "Graphs", "C++20", "P/Invoke" },
            "/Projects/Network/Index", "/Projects/Network/Details", "View technical details for Route Planner"),
        ("clustering", "fa-fire", "Hotspot Clusterer",
            "Density-based clustering (DBSCAN) that groups incident points into hotspots and separates them from noise, over a native-backed clustering kernel.",
            new[] { "Clustering", "DBSCAN", "C++20", "P/Invoke" },
            "/Projects/Clustering", "/Projects/Clustering/Details", "View technical details for Hotspot Clusterer"),
        ("viewshed", "fa-eye", "Viewshed Analyzer",
            "Line-of-sight visibility analysis over a terrain grid — place an observer and see what they can see, over a native-backed ray-casting kernel.",
            new[] { "Viewshed", "Line-of-Sight", "C++20", "ASP.NET Core" },
            "/Projects/Viewshed", "/Projects/Viewshed/Details", "View technical details for Viewshed Analyzer"),
        ("overlay", "fa-shapes", "Spatial Overlay / Zone Tagger",
            "Point-in-polygon spatial join that tags points with their containing zone and rolls the counts into a live choropleth, over a native-backed overlay kernel.",
            new[] { "Spatial Join", "Point-in-Polygon", "C++20", "P/Invoke" },
            "/Projects/Overlay", "/Projects/Overlay/Details", "View technical details for Spatial Overlay"),
        ("cat-risk", "fa-fire-flame-curved", "Catastrophe Risk Analyzer",
            "Insurance catastrophe model for wildfire exposure — ring accumulation, Monte Carlo event-loss simulation, and the exceedance probability curve.",
            new[] { "Insurance", "Monte Carlo", "C++20", "P/Invoke" },
            "/Projects/CatRisk", "/Projects/CatRisk/Details", "View technical details for Catastrophe Risk Analyzer"),
        ("change-detection", "fa-satellite", "Raster Change Detection",
            "Multitemporal satellite change detection — Change Vector Analysis, an automatic Otsu threshold, morphological speckle removal, and connected-component extraction.",
            new[] { "Remote Sensing", "Canvas", "C++20", "P/Invoke" },
            "/Projects/Change", "/Projects/Change/Details", "View technical details for Raster Change Detection"),
        ("outage", "fa-bolt", "Outage Manager & Network Trace",
            "Electric distribution outage management — fault tracing, isolation devices, and tie-switch restoration planning.",
            new[] { "Utilities", "Graph Traversal", "C++20", "P/Invoke" },
            "/Projects/Outage", "/Projects/Outage/Details", "View technical details for Outage Manager"),
        ("response-coverage", "fa-truck-medical", "Emergency Response Coverage Optimizer",
            "Fire station siting over a real street network — drive-time isochrones and p-median optimization scored on the NFPA 1710 standard.",
            new[] { "Public Safety", "p-median", "C++20", "P/Invoke" },
            "/Projects/Response", "/Projects/Response/Details", "View technical details for the Emergency Response Coverage Optimizer"),
        ("fleet", "fa-truck-fast", "Fleet Route Optimizer",
            "Capacitated vehicle routing with time windows over the real Redlands street network — savings construction plus 2-opt and Or-opt local search.",
            new[] { "Logistics", "CVRPTW", "C++20", "Leaflet" },
            "/Projects/Fleet", "/Projects/Fleet/Details", "View technical details for Fleet Route Optimizer")
    };
}

<!-- Hero -->
<section id="hero" class="hero-section" role="region" aria-label="Hero">
    <div class="container">
        <div class="hero-content text-center">
            <h1 class="hero-title">Brian Coffey</h1>
            <p class="hero-subtitle">
                Software Engineer
            </p>
            <p class="hero-desc">
                Software engineer specializing in C# and ASP.NET Core web services,
                building secure and scalable applications. Experience developing
                RESTful APIs, enterprise systems, and web GIS solutions that enable
                data-driven decision making.
            </p>
            <div class="hero-cta">
                <a href="#projects" class="btn btn-accent btn-lg me-2">View Projects</a>
                <a href="#contact" class="btn btn-outline-accent btn-lg">Contact</a>
            </div>
        </div>
    </div>
</section>

<!-- Skills -->
<section id="skills" class="skills-section py-5" role="region" aria-labelledby="skillsHeading">
    <div class="container">
        <h2 id="skillsHeading" class="section-title text-center mb-5">Technical Skills</h2>
        <div class="row g-4 justify-content-center">
            <!-- GIS -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="skill-card h-100" aria-hidden="false">
                    <div class="skill-icon" aria-hidden="true"><i class="fa-solid fa-map-location-dot"></i></div>
                    <h3>GIS</h3>
                    <ul class="skill-list" aria-label="GIS Skills">
                        <li><span class="skill-tag">Spatial Analysis</span></li>
                        <li><span class="skill-tag">Geoprocessing</span></li>
                        <li><span class="skill-tag">Geodatabases</span></li>
                        <li><span class="skill-tag">Geocoding & Reverse Geocoding</span></li>
                        <li><span class="skill-tag">Address Standardization</span></li>
                    </ul>
                </div>
            </div>

            <!-- Programming -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="skill-card h-100">
                    <div class="skill-icon" aria-hidden="true"><i class="fa-solid fa-code"></i></div>
                    <h3>Programming</h3>
                    <ul class="skill-list" aria-label="Programming Languages">
                        <li><span class="skill-tag">C#</span></li>
                        <li><span class="skill-tag">C++</span></li>
                        <li><span class="skill-tag">JavaScript</span></li>
                        <li><span class="skill-tag">SQL</span></li>
                        <li><span class="skill-tag">HTML / CSS</span></li>
                    </ul>
                </div>
            </div>

            <!-- Frameworks & Web GIS -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="skill-card h-100">
                    <div class="skill-icon" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></div>
                    <h3>Frameworks & Web GIS</h3>
                    <ul class="skill-list" aria-label="Frameworks and Web GIS">
                        <li><span class="skill-tag">ASP.NET Core</span></li>
                        <li><span class="skill-tag">Razor Pages</span></li>
                        <li><span class="skill-tag">Entity Framework</span></li>
                        <li><span class="skill-tag">ArcGIS JS API</span></li>
                        <li><span class="skill-tag">RESTful APIs</span></li>
                    </ul>
                </div>
            </div>

            <!-- Tools & Practices -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="skill-card h-100">
                    <div class="skill-icon" aria-hidden="true"><i class="fa-solid fa-toolbox"></i></div>
                    <h3>Tools & Practices</h3>
                    <ul class="skill-list" aria-label="Tools and practices">
                        <li><span class="skill-tag">PostgreSQL / SQL Server</span></li>
                        <li><span class="skill-tag">Git / GitHub</span></li>
                        <li><span class="skill-tag">Azure DevOps</span></li>
                        <li><span class="skill-tag">xUnit / Moq</span></li>
                        <li><span class="skill-tag">DevSecOps / Fortify</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Projects -->
<section id="projects" class="projects-section py-5" role="region" aria-labelledby="projectsHeading">
    <div class="container">
        <h2 id="projectsHeading" class="section-title text-center mb-3">Featured Projects</h2>

        <!-- Revealed by carousel.js; without script the carousel is just a marquee. -->
        <div class="projects-controls text-center mb-3">
            <button type="button" id="projectsPause" class="btn btn-outline-accent btn-sm" aria-pressed="false" aria-controls="projectsSlider" hidden>
                <i class="fa-solid fa-pause" aria-hidden="true"></i>
                <span>Pause carousel</span>
            </button>
        </div>

        <div id="projectsSlider" class="projects-slider" role="region" aria-label="Project cards carousel">
            <div class="projects-track">
                @for (var pass = 0; pass < 2; pass++)
                {
                    foreach (var c in projects)
                    {
                        <partial name="_ProjectCard" model="(c.Id, c.Icon, c.Title, c.Desc, c.Stack, c.Demo, c.Details, c.DetailsLabel, pass == 1)" />
                    }
                }
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/Projects" class="btn btn-outline-accent">View all projects</a>
        </div>
    </div>
</section>

<!-- About -->
<section id="about" class="about-section py-5" role="region" aria-labelledby="aboutHeading">
    <div class="container">
        <h2 id="aboutHeading" class="section-title text-center mb-4">About</h2>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="about-card">
                    <p>
                        Software Engineer with 2+ years of experience developing
                        ASP.NET Core and C# applications that support enterprise
                        operations and data-driven decision making. Experienced
                        building RESTful APIs, modernizing legacy systems, and
                        designing secure and scalable backend services using
                        SQL Server and Entity Framework.
                    </p>

                    <p>
                        My work includes developing web applications that automate 
                        complex workflows and improve organizational efficiency. 
                        I have led Agile teams through the full software lifecycle including
                        architecture, implementation, testing, and deployment.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Résumé -->
@* Same skeleton as About: left-aligned .section-title, then one centered
   .col-lg-8 card. No text-center on the container — .section-title is
   display:inline-block, so a centered container is what pushed this heading
   to the middle while every other section's sat left. Still no prose; the
   card exists to give the two buttons a surface to sit on. *@
<section id="resume" class="resume-section py-5" role="region" aria-labelledby="resumeHeading">
    <div class="container">
        <h2 id="resumeHeading" class="section-title mb-4">Résumé</h2>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="resume-card">
                    <p class="resume-lead">
                        A one-page summary of my background in backend and full-stack
                        engineering, API design, and cloud deployment.
                    </p>
                    <div class="resume-actions">
                        <a class="btn btn-accent"
                           href="~/files/Brian-Coffey-Resume.pdf"
                           download="Brian-Coffey-Resume.pdf">
                            <i class="fa-solid fa-download me-2" aria-hidden="true"></i>Download PDF
                        </a>
                        <a class="btn btn-outline-accent"
                           href="~/files/Brian-Coffey-Resume.pdf"
                           target="_blank"
                           rel="noopener">
                            <i class="fa-solid fa-up-right-from-square me-2" aria-hidden="true"></i>View<span class="visually-hidden"> résumé in a new tab</span>
                        </a>
                    </div>
                    @* Read from the file at request time, so replacing the PDF updates
                       these without anyone remembering to edit the markup. *@
                    @if (!string.IsNullOrEmpty(Model.ResumeMeta))
                    {
                        <p class="resume-meta">@Model.ResumeMeta</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

