@page
@model Portfolio.Web.Pages.Projects.BatchGeocoding.IndexModel
@using Portfolio.Common.Models
@{
	Layout = "/Pages/Shared/_Layout.cshtml";
	ViewData["Title"] = "Batch Geocoding";
}

@section Styles {
	<link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" />
	<link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css" />
	<link rel="stylesheet" href="~/css/gis.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/batchgeocoding.css" asp-append-version="true" />
}

<partial name="_ProjectHero" model='new ProjectHero("Batch Geocoding", "fa-solid fa-map-location-dot", "Upload a CSV of addresses and geocode them in bulk via ArcGIS.", new[] { new ProjectHeroBadge("fa-solid fa-satellite-dish", "ArcGIS Geocoding API") }, "/Projects/BatchGeocoding/Details")' />

<div class="batch-geocoding-page">

	<!-- MAIN CONTENT -->
	<div class="container pb-5">

		<!-- Alert area for client-side validation errors -->
		<div id="uploadAlert" class="alert alert-warning alert-dismissible fade d-none mb-3" role="alert">
			<i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
			<span id="uploadAlertMsg"></span>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>

		<div class="row g-4">

			<!-- LEFT PANEL: UPLOAD CONTROLS -->
			<div class="col-lg-4">
				<div class="card shadow-sm h-100 theme-card">
					<div class="card-header theme-card-header d-flex align-items-center gap-2">
						<i class="fa-solid fa-upload text-accent" aria-hidden="true"></i>
						<h2 class="h6 mb-0">Upload CSV</h2>
					</div>
					<div class="card-body d-flex flex-column gap-3">

						<!-- Drag-and-drop zone -->
						<div id="uploadZone" class="upload-zone text-center" role="button" tabindex="0"
							 aria-label="Drag and drop a CSV file here or click to browse">
							<i class="fa-solid fa-file-csv fa-3x mb-2 text-accent" aria-hidden="true"></i>
							<p class="mb-0 fw-semibold">Drag &amp; drop a CSV file here</p>
							<p class="mb-0 theme-text-muted small">or click to browse</p>
						</div>

						<!-- Hidden file input -->
						<input type="file" id="csvFileInput" accept=".csv" class="d-none" aria-label="Select CSV file" />

						<!-- Expected format -->
						<div>
							<p class="mb-1 small fw-semibold theme-text-muted">Expected format:</p>
							<pre class="format-example mb-0">Id,Address,City,State,Zip
1,123 Main St,Los Angeles,CA,90001</pre>
						</div>

						<!-- Sample downloads -->
						<div>
							<p class="mb-1 small fw-semibold theme-text-muted">
								<i class="fa-solid fa-download me-1" aria-hidden="true"></i>Download a sample CSV:
							</p>
							<div class="d-flex flex-column gap-1">
								<a href="~/samples/batch-geocoding/us-landmarks.csv" download class="btn btn-sm btn-outline-secondary text-start">
									<i class="fa-solid fa-monument me-1" aria-hidden="true"></i>US Landmarks <span class="theme-text-muted">(10 rows)</span>
								</a>
								<a href="~/samples/batch-geocoding/tech-campuses.csv" download class="btn btn-sm btn-outline-secondary text-start">
									<i class="fa-solid fa-building me-1" aria-hidden="true"></i>Tech Campuses <span class="theme-text-muted">(10 rows)</span>
								</a>
								<a href="~/samples/batch-geocoding/sports-stadiums.csv" download class="btn btn-sm btn-outline-secondary text-start">
									<i class="fa-solid fa-futbol me-1" aria-hidden="true"></i>Sports Stadiums <span class="theme-text-muted">(10 rows)</span>
								</a>
								<a href="~/samples/batch-geocoding/mixed-results.csv" download class="btn btn-sm btn-outline-secondary text-start">
									<i class="fa-solid fa-circle-half-stroke me-1" aria-hidden="true"></i>Mixed Results <span class="theme-text-muted">(12 rows, 1 bad)</span>
								</a>
							</div>
						</div>

						<!-- File info card (hidden until file selected) -->
						<div id="fileInfoCard" class="file-info-card d-none">
							<div class="d-flex align-items-center gap-2 mb-1">
								<i class="fa-solid fa-file-csv text-accent" aria-hidden="true"></i>
								<span id="fileInfoName" class="fw-semibold text-truncate"></span>
							</div>
							<div class="d-flex gap-3 small theme-text-muted">
								<span><i class="fa-solid fa-weight-hanging me-1" aria-hidden="true"></i><span id="fileInfoSize"></span></span>
								<span><i class="fa-solid fa-list-ol me-1" aria-hidden="true"></i><span id="fileInfoRows"></span> data rows</span>
							</div>
						</div>

						<!-- Actions -->
						<div class="d-flex flex-column gap-2 mt-auto">
							<button id="btnGeocode" class="btn btn-accent w-100" disabled>
								<i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i>Geocode Addresses
							</button>
							<button id="btnClear" class="btn btn-outline-secondary w-100 d-none">
								<i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Clear
							</button>
						</div>

					</div>
				</div>
			</div>

			<!-- RIGHT PANEL: RESULTS -->
			<div class="col-lg-8">
				<div class="card shadow-sm h-100 position-relative theme-card">
					<div class="card-header theme-card-header d-flex align-items-center gap-2">
						<i class="fa-solid fa-table-list text-accent" aria-hidden="true"></i>
						<h2 class="h6 mb-0">Geocoding Results</h2>
					</div>
					<div class="card-body">

						<!-- Spinner overlay -->
						<div id="spinnerOverlay" class="spinner-overlay d-none" role="status">
							<div class="spinner-border text-accent" aria-hidden="true"></div>
							<p class="mt-2 mb-0 theme-text-muted small">Geocoding addresses…</p>
						</div>

						<!-- API error alert -->
						<div id="apiAlert" class="alert alert-danger alert-dismissible fade d-none" role="alert">
							<i class="fa-solid fa-circle-xmark me-1" aria-hidden="true"></i>
							<span id="apiAlertMsg"></span>
							<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
						</div>

						<!-- Placeholder state -->
						<div id="resultsPlaceholder" class="results-placeholder">
							<i class="fa-solid fa-map-marker-alt fa-3x mb-3 theme-text-muted" aria-hidden="true"></i>
							<p class="theme-text-muted mb-0">Upload a CSV to see geocoding results.</p>
						</div>

						<!-- Results content (hidden until data arrives) -->
						<div id="resultsContent" class="d-none">

							<!-- Summary bar -->
							<div class="summary-bar mb-3">
								<p id="summaryText" class="mb-2 fw-semibold"></p>
								<div class="row g-2 mb-3">
									<div class="col-4">
										<div class="kpi-card text-center">
											<div class="kpi-value" id="kpiTotal">0</div>
											<div class="kpi-label">Total Rows</div>
										</div>
									</div>
									<div class="col-4">
										<div class="kpi-card text-center kpi-success">
											<div class="kpi-value" id="kpiMatched">0</div>
											<div class="kpi-label">Matched</div>
										</div>
									</div>
									<div class="col-4">
										<div class="kpi-card text-center kpi-danger">
											<div class="kpi-value" id="kpiUnmatched">0</div>
											<div class="kpi-label">Unmatched</div>
										</div>
									</div>
								</div>
								<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
									<div class="btn-group" role="group" aria-label="Filter results">
										<button type="button" class="btn btn-sm btn-accent filter-btn active" data-filter="all" aria-pressed="true">All</button>
										<button type="button" class="btn btn-sm btn-outline-accent filter-btn" data-filter="matched" aria-pressed="false">Matched</button>
										<button type="button" class="btn btn-sm btn-outline-accent filter-btn" data-filter="unmatched" aria-pressed="false">Unmatched</button>
									</div>
									<button id="btnExport" type="button" class="btn btn-sm btn-outline-accent">
										<i class="fa-solid fa-download me-1" aria-hidden="true"></i>Export CSV
									</button>
								</div>
							</div>

							<!-- Results table -->
							<div class="table-responsive">
								<table id="resultsTable" class="table table-striped table-hover w-100">
									<caption class="visually-hidden">Geocoding results</caption>
									<thead>
										<tr>
											<th scope="col">#</th>
											<th scope="col">Original Address</th>
											<th scope="col">Status</th>
											<th scope="col">Matched Address</th>
											<th scope="col">Score</th>
											<th scope="col">Lat</th>
											<th scope="col">Lng</th>
										</tr>
									</thead>
									<tbody></tbody>
								</table>
							</div>

						</div>

					</div>
				</div>
			</div>

		</div>
	</div>
</div>

@section Scripts {
	<script defer src="~/lib/jquery/jquery-3.7.1.min.js"></script>
	<script defer src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
	<script defer src="~/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
	<script defer src="~/js/BatchGeocoding/app.js" asp-append-version="true"></script>
}
