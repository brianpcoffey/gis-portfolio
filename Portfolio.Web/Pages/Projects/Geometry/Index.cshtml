@page
@using Portfolio.Common.Models
@model Portfolio.Web.Pages.Projects.Geometry.IndexModel
@{
	Layout = "/Pages/Shared/_Layout.cshtml";
	ViewData["Title"] = "Geometry Toolkit";
	var hero = new ProjectHero("Geometry Toolkit", "fa-solid fa-draw-polygon", "Run native-backed computational geometry operations and render the result as vector shapes.",
		new[] { new ProjectHeroBadge("fa-solid fa-vector-square", "C++ Geometry Kernel MVP") }, "/Projects/Geometry/Details");
}

@section Styles {
	<link rel="stylesheet" href="~/css/gis.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/spatialcompute.css" asp-append-version="true" />
}

<div class="spatial-compute-page theme-root">
	<partial name="_ProjectHero" model="hero" />

	<div class="container pb-5">
		<div id="geometryAlert" class="alert alert-danger d-none" role="alert"></div>
		<div class="row g-4">
			<div class="col-lg-4">
				<div class="card spatial-card shadow-sm h-100">
					<div class="card-header d-flex align-items-center gap-2"><i class="fa-solid fa-code text-accent" aria-hidden="true"></i><h2 class="h6 mb-0">Geometry Input</h2></div>
					<div class="card-body d-flex flex-column gap-3">
						<label for="geometryPoints" class="form-label small mb-0">Point set JSON</label>
						<textarea id="geometryPoints" class="form-control font-monospace" rows="9"></textarea>
						<button id="geometryTriangulateBtn" class="btn btn-accent"><i class="fa-solid fa-play me-1" aria-hidden="true"></i>Triangulate</button>
						<hr />
						<fieldset class="border-0 p-0 m-0">
							<legend class="form-label small mb-3 float-none w-auto">Clip bounding box</legend>
							<div class="row g-2">
								<div class="col-6"><input id="clipMinX" class="form-control" type="number" step="0.1" value="0.15" aria-label="Minimum X" /></div>
								<div class="col-6"><input id="clipMinY" class="form-control" type="number" step="0.1" value="0.15" aria-label="Minimum Y" /></div>
								<div class="col-6"><input id="clipMaxX" class="form-control" type="number" step="0.1" value="0.85" aria-label="Maximum X" /></div>
								<div class="col-6"><input id="clipMaxY" class="form-control" type="number" step="0.1" value="0.85" aria-label="Maximum Y" /></div>
							</div>
						</fieldset>
						<button id="geometryClipBtn" class="btn btn-outline-accent"><i class="fa-solid fa-crop-simple me-1" aria-hidden="true"></i>Clip Vertices</button>
					</div>
				</div>
			</div>
			<div class="col-lg-8">
				<div class="card spatial-card shadow-sm h-100">
					<div class="card-header d-flex align-items-center gap-2"><i class="fa-solid fa-bezier-curve text-accent" aria-hidden="true"></i><h2 class="h6 mb-0">Geometry Visualization</h2></div>
					<div class="card-body">
						<div class="row g-3 mb-3">
							<div class="col-md-4"><div class="kpi-card text-center"><div id="geometryKpiShapes" class="kpi-value">0</div><div class="kpi-label">Shapes</div></div></div>
							<div class="col-md-4"><div class="kpi-card text-center"><div id="geometryKpiNative" class="kpi-value">No</div><div class="kpi-label">Native</div></div></div>
							<div class="col-md-4"><div class="kpi-card text-center"><div id="geometryKpiMode" class="kpi-value">—</div><div class="kpi-label">Operation</div></div></div>
						</div>
						<div class="spatial-map-panel p-2">
							<svg id="geometrySvg" viewBox="0 0 100 100" width="100%" height="420" role="img" aria-label="Geometry operation visualization"></svg>
						</div>
						<pre id="geometryResult" class="sample-json mt-3 mb-0"></pre>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script defer src="~/js/Geometry/app.js" asp-append-version="true"></script>
}
