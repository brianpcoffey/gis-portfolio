@page
@using Portfolio.Common.Models
@model Portfolio.Web.Pages.Projects.Terrain.IndexModel
@{
	Layout = "/Pages/Shared/_Layout.cshtml";
	ViewData["Title"] = "Terrain Analyzer";
	var hero = new ProjectHero("Terrain Analyzer", "fa-solid fa-mountain-sun", "Generate hillshade and heatmap rasters from dense grid math backed by a native terrain kernel.",
		new[] { new ProjectHeroBadge("fa-solid fa-layer-group", "C++ Raster Kernel MVP") }, "/Projects/Terrain/Details");
}

@section Styles {
	<link rel="stylesheet" href="~/css/gis.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/spatialcompute.css" asp-append-version="true" />
}

<div class="spatial-compute-page theme-root">
	<partial name="_ProjectHero" model="hero" />

	<div class="container pb-5">
		<div id="terrainAlert" class="alert alert-danger d-none" role="alert"></div>
		<div class="row g-4">
			<div class="col-lg-4">
				<div class="card spatial-card shadow-sm h-100">
					<div class="card-header d-flex align-items-center gap-2"><i class="fa-solid fa-sliders text-accent" aria-hidden="true"></i><h2 class="h6 mb-0">Raster Controls</h2></div>
					<div class="card-body d-flex flex-column gap-3">
						<div class="row g-2">
							<div class="col-6">
								<label for="terrainWidth" class="form-label small">Width</label>
								<input id="terrainWidth" class="form-control" type="number" min="4" max="24" value="12" />
							</div>
							<div class="col-6">
								<label for="terrainHeight" class="form-label small">Height</label>
								<input id="terrainHeight" class="form-control" type="number" min="4" max="24" value="12" />
							</div>
						</div>
						<div>
							<label for="terrainAzimuth" class="form-label small d-flex justify-content-between"><span>Hillshade azimuth</span><span id="terrainAzimuthValue" class="text-accent" aria-hidden="true">315°</span></label>
							<input id="terrainAzimuth" class="form-range" type="range" min="0" max="360" value="315" aria-valuetext="315°" />
						</div>
						<button id="terrainHillshadeBtn" class="btn btn-accent"><i class="fa-solid fa-sun me-1" aria-hidden="true"></i>Generate Hillshade</button>
						<button id="terrainHeatmapBtn" class="btn btn-outline-accent"><i class="fa-solid fa-fire me-1" aria-hidden="true"></i>Generate Heatmap</button>
						<pre id="terrainSummary" class="sample-json mt-auto mb-0" tabindex="0" role="region" aria-label="Terrain analysis summary"></pre>
					</div>
				</div>
			</div>
			<div class="col-lg-8">
				<div class="card spatial-card shadow-sm h-100">
					<div class="card-header d-flex align-items-center gap-2"><i class="fa-solid fa-table-cells text-accent" aria-hidden="true"></i><h2 class="h6 mb-0">Raster Output</h2></div>
					<div class="card-body">
						<div class="row g-3 mb-3">
							<div class="col-md-4"><div class="kpi-card text-center"><div id="terrainKpiCells" class="kpi-value">0</div><div class="kpi-label">Cells</div></div></div>
							<div class="col-md-4"><div class="kpi-card text-center"><div id="terrainKpiNative" class="kpi-value">No</div><div class="kpi-label">Native</div></div></div>
							<div class="col-md-4"><div class="kpi-card text-center"><div id="terrainKpiMode" class="kpi-value">—</div><div class="kpi-label">Mode</div></div></div>
						</div>
						<div class="spatial-map-panel d-flex align-items-center justify-content-center p-3">
							<div id="terrainGrid" class="raster-grid" role="img" aria-label="Raster output grid: no results yet"></div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script defer src="~/js/Terrain/app.js" asp-append-version="true"></script>
}
