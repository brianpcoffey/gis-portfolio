@page
@using Portfolio.Common.Models
@model Portfolio.Web.Pages.Projects.Viewshed.IndexModel
@{
	Layout = "/Pages/Shared/_Layout.cshtml";
	ViewData["Title"] = "Viewshed Analyzer";
	var hero = new ProjectHero("Viewshed Analyzer", "fa-solid fa-eye", "Line-of-sight visibility over a terrain grid — click any cell to place the observer and see what they can see, backed by a native C++ ray-casting kernel.",
		new[] { new ProjectHeroBadge("fa-solid fa-mountain", "C++ Viewshed Kernel") }, "/Projects/Viewshed/Details");
}

@section Styles {
	<link rel="stylesheet" href="~/css/gis.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/spatialcompute.css" asp-append-version="true" />
}

<div class="spatial-compute-page theme-root">
	<partial name="_ProjectHero" model="hero" />

	<div class="container pb-5">
		<div id="viewshedAlert" class="alert alert-danger d-none" role="alert"></div>
		<div class="row g-4">
			<div class="col-lg-4">
				<div class="card spatial-card shadow-sm h-100">
					<div class="card-header d-flex align-items-center gap-2"><i class="fa-solid fa-sliders text-accent" aria-hidden="true"></i><h2 class="h6 mb-0">Observer Controls</h2></div>
					<div class="card-body d-flex flex-column gap-3">
						<div>
							<label for="viewshedSize" class="form-label small">Grid size (cells per side)</label>
							<input id="viewshedSize" class="form-control" type="number" min="8" max="40" value="24" />
						</div>
						<div>
							<label for="viewshedHeight" class="form-label small d-flex justify-content-between">
								<span>Observer height (m)</span><span id="viewshedHeightValue" class="text-accent">2</span>
							</label>
							<input id="viewshedHeight" class="form-range" type="range" min="0" max="60" step="1" value="2" />
						</div>
						<div>
							<label for="viewshedTerrain" class="form-label small">Terrain type</label>
							<select id="viewshedTerrain" class="form-select">
								<option value="ridge" selected>Ridge &amp; valley</option>
								<option value="peak">Central peak</option>
								<option value="rolling">Rolling hills</option>
							</select>
						</div>
						<div class="row g-2">
							<div class="col-6">
								<label for="viewshedObserverX" class="form-label small">Observer column</label>
								<input id="viewshedObserverX" class="form-control" type="number" min="0" max="23" step="1" value="12" />
							</div>
							<div class="col-6">
								<label for="viewshedObserverY" class="form-label small">Observer row</label>
								<input id="viewshedObserverY" class="form-control" type="number" min="0" max="23" step="1" value="12" />
							</div>
						</div>
						<p class="text-muted theme-text-muted small mb-0"><i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>Click a cell in the grid, or set the observer column and row, then re-run.</p>
						<button id="viewshedRunBtn" class="btn btn-accent"><i class="fa-solid fa-eye me-1" aria-hidden="true"></i>Compute Viewshed</button>
						<button id="viewshedRegenBtn" class="btn btn-outline-accent"><i class="fa-solid fa-arrows-rotate me-1" aria-hidden="true"></i>Regenerate Terrain</button>
						<pre id="viewshedSummary" class="sample-json mt-auto mb-0" tabindex="0" role="region" aria-label="Viewshed summary"></pre>
					</div>
				</div>
			</div>
			<div class="col-lg-8">
				<div class="card spatial-card shadow-sm h-100">
					<div class="card-header d-flex align-items-center gap-2"><i class="fa-solid fa-table-cells text-accent" aria-hidden="true"></i><h2 class="h6 mb-0">Visibility Map</h2></div>
					<div class="card-body">
						<div class="row g-3 mb-3">
							<div class="col-md-3"><div class="kpi-card text-center"><div id="viewshedKpiVisible" class="kpi-value">0</div><div class="kpi-label">Visible</div></div></div>
							<div class="col-md-3"><div class="kpi-card text-center"><div id="viewshedKpiPct" class="kpi-value">0%</div><div class="kpi-label">Coverage</div></div></div>
							<div class="col-md-3"><div class="kpi-card text-center"><div id="viewshedKpiObserver" class="kpi-value">—</div><div class="kpi-label">Observer</div></div></div>
							<div class="col-md-3"><div class="kpi-card text-center"><div id="viewshedKpiNative" class="kpi-value">No</div><div class="kpi-label">Native</div></div></div>
						</div>
						<div class="spatial-map-panel d-flex align-items-center justify-content-center p-3">
							<div id="viewshedGrid" class="raster-grid" role="group" aria-label="Viewshed visibility grid"></div>
						</div>
						<div class="d-flex flex-wrap gap-3 mt-3 small text-muted theme-text-muted">
							<span><span class="viewshed-swatch viewshed-swatch-visible"></span> Visible terrain</span>
							<span><span class="viewshed-swatch viewshed-swatch-hidden"></span> Hidden terrain</span>
							<span><span class="viewshed-swatch viewshed-swatch-observer"></span> Observer</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script defer src="~/js/Viewshed/app.js" asp-append-version="true"></script>
}
