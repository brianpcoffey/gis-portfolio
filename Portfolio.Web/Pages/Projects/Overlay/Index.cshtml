@page
@using Portfolio.Common.Models
@model Portfolio.Web.Pages.Projects.Overlay.IndexModel
@{
	Layout = "/Pages/Shared/_Layout.cshtml";
	ViewData["Title"] = "Spatial Overlay / Zone Tagger";
	var hero = new ProjectHero("Spatial Overlay / Zone Tagger", "fa-solid fa-shapes", "Point-in-polygon spatial join — tag thousands of points with the zone that contains them and roll up per-zone counts into a live choropleth, backed by a native C++ kernel.",
		new[] { new ProjectHeroBadge("fa-solid fa-vector-square", "C++ Overlay Kernel") }, "/Projects/Overlay/Details");
}

@section Styles {
	<link rel="stylesheet" href="~/css/gis.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/spatialcompute.css" asp-append-version="true" />
}

<div class="spatial-compute-page theme-root">
	<partial name="_ProjectHero" model="hero" />

	<div class="container pb-5">
		<div id="overlayAlert" class="alert alert-danger d-none" role="alert"></div>
		<div class="row g-4">
			<div class="col-lg-4">
				<div class="card spatial-card shadow-sm h-100">
					<div class="card-header d-flex align-items-center gap-2"><i class="fa-solid fa-sliders text-accent" aria-hidden="true"></i><h2 class="h6 mb-0">Join Controls</h2></div>
					<div class="card-body d-flex flex-column gap-3">
						<div>
							<label for="overlayPointCount" class="form-label small">Number of points</label>
							<input id="overlayPointCount" class="form-control" type="number" min="20" max="4000" step="20" value="600" />
						</div>
						<div>
							<label for="overlayZones" class="form-label small">Zone layout</label>
							<select id="overlayZones" class="form-select">
								<option value="quadrants" selected>Four district quadrants</option>
								<option value="strips">Three vertical strips</option>
								<option value="diamond">Central diamond + corners</option>
							</select>
						</div>
						<button id="overlayRunBtn" class="btn btn-accent"><i class="fa-solid fa-object-group me-1" aria-hidden="true"></i>Run Spatial Join</button>
						<button id="overlayRegenBtn" class="btn btn-outline-accent"><i class="fa-solid fa-arrows-rotate me-1" aria-hidden="true"></i>Regenerate Points</button>
						<div id="overlayZoneTable"></div>
						<pre id="overlaySummary" class="sample-json mt-auto mb-0" tabindex="0" role="region" aria-label="Spatial join summary"></pre>
					</div>
				</div>
			</div>
			<div class="col-lg-8">
				<div class="card spatial-card shadow-sm h-100">
					<div class="card-header d-flex align-items-center gap-2"><i class="fa-solid fa-map text-accent" aria-hidden="true"></i><h2 class="h6 mb-0">Zone Choropleth</h2></div>
					<div class="card-body">
						<div class="row g-3 mb-3">
							<div class="col-md-3"><div class="kpi-card text-center"><div id="overlayKpiPoints" class="kpi-value">0</div><div class="kpi-label">Points</div></div></div>
							<div class="col-md-3"><div class="kpi-card text-center"><div id="overlayKpiZones" class="kpi-value">0</div><div class="kpi-label">Zones</div></div></div>
							<div class="col-md-3"><div class="kpi-card text-center"><div id="overlayKpiUnassigned" class="kpi-value">0</div><div class="kpi-label">Outside</div></div></div>
							<div class="col-md-3"><div class="kpi-card text-center"><div id="overlayKpiNative" class="kpi-value">No</div><div class="kpi-label">Native</div></div></div>
						</div>
						<div class="spatial-map-panel d-flex align-items-center justify-content-center p-3">
							<svg id="overlaySvg" role="img" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" class="w-100" style="max-width: 480px; aspect-ratio: 1;" aria-label="Zone choropleth with points"></svg>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script defer src="~/js/Overlay/app.js" asp-append-version="true"></script>
}
