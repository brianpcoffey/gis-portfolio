@page
@using Portfolio.Common.Models
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "US State Explorer – Interactive GIS Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/gis.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/stateexplorer.css" asp-append-version="true" />
}

<partial name="_ProjectHero" model='new ProjectHero("US State Explorer", "fa-solid fa-map", "Explore, compare, and save U.S. states using interactive GIS tools.", new[] { new ProjectHeroBadge("fa-solid fa-globe", "ArcGIS Feature Layer") }, "/Projects/StateExplorer/Details")' />

<div class="container-fluid py-3 theme-root state-explorer-page">
    <!-- TOOLBAR -->
    <div class="row mb-3">
        <!-- Align search with left sidebar (matches col sizes used below) -->
        <div class="col-lg-3 col-md-4">
            <div class="theme-toolbar p-3 rounded d-flex align-items-center">
                <div class="input-group flex-nowrap w-100">
                    <span class="input-group-text d-flex align-items-center justify-content-center"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
                    <input id="searchInput" type="text" class="form-control" placeholder="Search states..." autocomplete="off" aria-label="Search states">
                </div>
            </div>
        </div>

        <!-- Center toolbar actions -->
        <div class="col-lg-6 col-md-8">
            <div class="theme-toolbar p-3 rounded d-flex flex-wrap gap-2 align-items-center">
                <button id="btnCompareMode" type="button" class="btn btn-outline-accent toolbar-btn" aria-pressed="false"><i class="fa-solid fa-chart-column me-1" aria-hidden="true"></i>Compare Mode</button>
                <button id="btnClearSelection" type="button" class="btn btn-outline-secondary toolbar-btn"><i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>Clear Selection</button>
                <button id="btnExport" type="button" class="btn btn-outline-accent toolbar-btn"><i class="fa-solid fa-download me-1" aria-hidden="true"></i>Export Data</button>
            </div>
        </div>

        <!-- Right toolbar (basemap select) — aligns with right column on large screens, stacks on smaller -->
        <div class="col-lg-3 col-md-12">
            <div class="theme-toolbar p-3 rounded d-flex align-items-center justify-content-end">
                <select id="basemapSelect" class="form-select form-select-sm se-basemap" aria-label="Select basemap">
                    <option value="streets-navigation-vector">Streets</option>
                    <option value="satellite">Satellite</option>
                    <option value="topo-vector">Topographic</option>
                    <option value="dark-gray-vector">Dark</option>
                </select>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- LEFT SIDEBAR -->
        <div class="col-lg-3 col-md-4">
            <div class="card shadow-sm mb-3 theme-card">
                <div class="card-header d-flex justify-content-between align-items-center theme-card-header">
                    <h2 class="h6 mb-0"><i class="fa-solid fa-folder me-1" aria-hidden="true"></i>My Collections</h2>
                    <button id="btnNewCollection" type="button" class="btn btn-sm btn-accent">+ New</button>
                </div>
                <div class="card-body p-0">
                    <div id="collectionsList" class="list-group list-group-flush se-scroll-sm">
                        <div class="list-group-item theme-text-muted text-center small">Loading...</div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm theme-card">
                <div class="card-header d-flex justify-content-between align-items-center theme-card-header">
                    <h2 class="h6 mb-0"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>Saved States</h2>
                    <span id="savedCount" class="badge theme-badge">0</span>
                </div>
                <div class="card-body p-0">
                    <div id="savedFeaturesList" class="list-group list-group-flush se-scroll-lg">
                        <div class="list-group-item theme-text-muted text-center small">No saved states yet</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CENTER - MAP -->
        <div class="col-lg-6 col-md-8">
            <div id="mapView" class="shadow-sm rounded theme-surface se-map" data-map-label="Map of U.S. states"></div>

            <div id="comparisonPanel" class="card mt-3 d-none theme-card">
                <div class="card-header d-flex justify-content-between align-items-center theme-card-header">
                    <h2 class="h6 mb-0"><i class="fa-solid fa-chart-column me-1" aria-hidden="true"></i>Comparison Results</h2>
                    <button id="btnCloseComparison" type="button" class="btn-close" aria-label="Close comparison"></button>
                </div>
                <div class="card-body comparison-panel theme-panel">
                    <div id="comparisonContent" aria-live="polite"></div>
                </div>
            </div>
        </div>

        <!-- RIGHT SIDEBAR -->
        <div class="col-lg-3 col-md-12">
            <div class="card shadow-sm mb-3 theme-card">
                <div class="card-header theme-card-header"><h2 class="h6 mb-0"><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i>State Details</h2></div>
                <div class="card-body" id="featureDetails" aria-live="polite">
                    <p class="theme-text-muted text-center small">Click a state on the map to view details</p>
                </div>
            </div>

            <div class="card shadow-sm theme-card">
                <div class="card-header theme-card-header"><h2 class="h6 mb-0"><i class="fa-solid fa-chart-line me-1" aria-hidden="true"></i>Statistics</h2></div>
                <div class="card-body">
                    <div id="statsPanel" class="row text-center g-2">
                        <div class="col-6">
                            <div class="border rounded p-3 theme-stat">
                                <div id="statTotal" class="h4 mb-0">0</div>
                                <small class="theme-text-muted">Total States</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3 theme-stat">
                                <div id="statSaved" class="h4 mb-0 se-stat-saved">0</div>
                                <small class="theme-text-muted">Saved</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3 theme-stat">
                                <div id="statSelected" class="h4 mb-0 se-stat-selected">0</div>
                                <small class="theme-text-muted">Selected</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-3 theme-stat">
                                <div id="statComparing" class="h4 mb-0 se-stat-comparing">0</div>
                                <small class="theme-text-muted">Comparing</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Save Feature Modal -->
<div class="modal fade" id="saveFeatureModal" tabindex="-1" aria-labelledby="saveFeatureModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content theme-modal">
            <div class="modal-header theme-modal-header">
                <h2 id="saveFeatureModalTitle" class="modal-title h5">Save State</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalFeatureId" />
                <div class="mb-3">
                    <label class="form-label" for="modalFeatureName">State Name</label>
                    <input type="text" id="modalFeatureName" class="form-control" readonly />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="modalDescription">Description / Notes</label>
                    <textarea id="modalDescription" class="form-control" rows="3" placeholder="Add notes about this state..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="modalCollection">Add to Collection</label>
                    <select id="modalCollection" class="form-select">
                        <option value="">-- None --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer theme-modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnConfirmSave" class="btn btn-accent">Save State</button>
            </div>
        </div>
    </div>
</div>

<!-- Collection Modal (create / edit; replaces window.prompt) -->
<div class="modal fade" id="collectionModal" tabindex="-1" aria-labelledby="collectionModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content theme-modal">
            <form id="collectionForm" novalidate>
                <div class="modal-header theme-modal-header">
                    <h2 id="collectionModalTitle" class="modal-title h5">New Collection</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="collectionName">Collection name</label>
                        <input type="text" id="collectionName" class="form-control" maxlength="100" required autocomplete="off" />
                        <div id="collectionNameError" class="invalid-feedback">Enter a name for the collection.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="collectionColor">Color</label>
                        <input type="color" id="collectionColor" class="form-control form-control-color" title="Collection color" />
                    </div>
                </div>
                <div class="modal-footer theme-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-accent">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Saved State Modal -->
<div class="modal fade" id="viewSavedModal" tabindex="-1" aria-labelledby="viewSavedTitle" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="viewSavedTitle" class="modal-title h5"></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="viewSavedMeta"></div>
      </div>
      <div class="modal-footer">
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script defer src="~/js/esri-theme.js" asp-append-version="true"></script>
    <script type="module" src="~/js/StateExplorer/stateStore.js" asp-append-version="true"></script>
    <script type="module" src="~/js/StateExplorer/featureService.js" asp-append-version="true"></script>
    <script type="module" src="~/js/StateExplorer/mapManager.js" asp-append-version="true"></script>
    <script type="module" src="~/js/StateExplorer/uiManager.js" asp-append-version="true"></script>
    <script type="module" src="~/js/StateExplorer/app.js" asp-append-version="true"></script>
}
